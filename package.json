{
  "name": "hanamii",
  "version": "0.1.1",
  "description": "hanamii CLI と MCP サーバー。国産 PaaS hanamii に ZIP からデプロイ、ログ取得、環境変数の設定、MCP 経由でのエージェント連携を行う。",
  "keywords": [
    "hanamii",
    "paas",
    "deploy",
    "cli",
    "mcp",
    "model-context-protocol",
    "japan"
  ],
  "homepage": "https://hanamii.jp",
  "bugs": "https://github.com/hanamii-sakura/hanamii-cli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanamii-sakura/hanamii-cli.git"
  },
  "license": "MIT",
  "author": "HANAMII, Inc.",
  "type": "module",
  "bin": {
    "hanamii": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "ignore": "^7.0.12",
    "picocolors": "^1.1.1",
    "yazl": "^3.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^2.15.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
